{
	code: "emberheart",
	class: "Item",
	behaviors: [
		{
			name: "EmberheartActivation",
			properties: {
				applicationTimeSec: 1.0,
				shellCode: "emberheart:emberheartshell",
				sound: "game:sounds/sizzle",
				soundRange: 12
			}
		},
		{ name: "GroundStorable", properties: { layout: 'Quadrants', collisionBox: { x1: 0, y1: 0, z1: 0, x2: 1, y2: 0.125, z2: 1 } } }
	],
	// Own shape: a faceted clay-and-wax pellet split by a glowing seam. The seam faces
	// carry a glow flag in the shape itself, so the core reads as lit without the item
	// having to emit light into the world.
	shape: { base: "emberheart:item/emberheart" },
	textures: {
		"shell": { base: "emberheart:item/emberheart-shell" },
		"core": { base: "emberheart:item/emberheart-core" }
	},
	// Single use and deliberately not hoardable in bulk.
	maxstacksize: 4,
	creativeinventory: { "general": ["*"], "items": ["*"] },
	materialDensity: 1200,
	attributes: {
		displaycaseable: true,
		shelvable: true,
		onDisplayTransform: {
			origin: { x: 0.5, y: 0, z: 0.5 },
			scale: 0.7
		},
		groundStorageTransform: {
			translation: { x: 0, y: -0.02, z: 0 },
			rotation: { x: 0, y: 14, z: 0 },
			scale: 0.9
		}
	},
	// Vanilla 3D items view the model from below, so an x rotation near 150 is what
	// stands it upright and tips the top - and therefore the seam - toward the camera.
	// The origin sits at the pellet's own centre so rotating and scaling keep it
	// centred in the slot.
	guiTransform: {
		translation: { x: 0, y: 0, z: 0 },
		rotation: { x: 150, y: -28, z: -7 },
		origin: { x: 0.5, y: 0.338, z: 0.5 },
		scale: 2.2
	},
	groundTransform: {
		translation: { x: 0, y: 0, z: 0 },
		rotation: { x: 0, y: 14, z: 0 },
		origin: { x: 0.5, y: 0, z: 0.5 },
		scale: 3.6
	},
	fpHandTransform: {
		translation: { x: 0.08, y: 0, z: 0 },
		rotation: { x: 0, y: 0, z: 0 },
		origin: { x: 0.5, y: 0, z: 0.5 },
		scale: 0.8
	},
	tpHandTransform: {
		translation: { x: -0.1, y: -0.05, z: -0.4 },
		rotation: { x: 0, y: 0, z: 0 },
		origin: { x: 0.5, y: 0, z: 0.5 },
		scale: 0.4
	}
}
